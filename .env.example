# ═══════════════════════════════════════════════════════════════════
# Fortivex AI — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in real keys to activate live APIs.
# Without any keys, the app runs fully on local mocks — no keys needed
# for the interview demo.
# ═══════════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────────
PORT=3001
FRONTEND_URL=http://localhost:5173

# ── Frontend API base (Vite reads VITE_ prefix) ───────────────────────
VITE_API_BASE_URL=http://localhost:3001

# ── OpenAI (for real LLM agent responses — optional) ──────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Deepgram (for real STT — optional, Web Speech API used by default) ─
# DEEPGRAM_API_KEY=...

# ── ElevenLabs (for real TTS voice — optional, Web Speech used by default)
# ELEVENLABS_API_KEY=...
# ELEVENLABS_VOICE_ID=...

# ── CRM Integrations (optional — mockCrmRecords.json used by default) ──
# HUBSPOT_API_KEY=...
# SALESFORCE_CLIENT_ID=...
# SALESFORCE_CLIENT_SECRET=...

# ── Calendar Integrations (optional — mock slots used by default) ──────
# GOOGLE_CALENDAR_CLIENT_ID=...
# GOOGLE_CALENDAR_CLIENT_SECRET=...
# CALENDLY_API_KEY=...

# ── Vector Database (optional — keyword search used by default) ─────────
# PINECONE_API_KEY=...
# PINECONE_INDEX=fortivex-kb
